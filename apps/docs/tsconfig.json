{
    "extends": [
        "astro/tsconfigs/strict",
        "../../tsconfig.json"
    ],
    "compilerOptions": {
        "baseUrl": ".",
        "paths": {
            "@/*": [
                "./src/*"
            ]
        },
        "types": [
            "astro/client"
        ]
    },
    "include": [
        ".astro/types.d.ts",
        "**/*"
    ],
    "exclude": [
        "node_modules",
        "dist",
        ".astro/"
    ]
}