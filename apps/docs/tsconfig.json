{
    "extends": [
        "astro/tsconfigs/strict",
        "../../tsconfig.json"
    ],
    "compilerOptions": {
        "baseUrl": ".",
        "paths": {
            "@/*": [
                "./src/*"
            ],
            "@components/*": [
                "./src/components/*"
            ],
            "@layouts/*": [
                "./src/layouts/*"
            ],
            "@lib/*": [
                "./src/lib/*"
            ],
            "@styles/*": [
                "./src/styles/*"
            ]
        },
        "types": [
            "astro/client"
        ]
    },
    "include": [
        ".astro/types.d.ts",
        "**/*"
    ],
    "exclude": [
        "node_modules",
        "dist",
        ".astro/"
    ]
}