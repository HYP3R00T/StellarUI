---
export interface Props {
  title?: string;
  variant?: 'default' | 'bordered' | 'elevated';
  padding?: 'sm' | 'md' | 'lg';
  class?: string;
}

const { title, variant = 'default', padding = 'md', class: className } = Astro.props as Props;

const baseStyles = 'rounded-lg bg-content';

const variants = {
  default: 'border border-border',
  bordered: 'border-2 border-accent',
  elevated: 'shadow-lg bg-elevated',
};

const paddings = {
  sm: 'p-4',
  md: 'p-6',
  lg: 'p-8',
};

const classes = `${baseStyles} ${variants[variant]} ${paddings[padding]} ${className || ''}`;
---

<div class={classes}>
  {title && <h3 class="text-text-default mb-4 text-xl font-semibold">{title}</h3>}
  <slot />
</div>
