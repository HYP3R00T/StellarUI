---
export interface Props {
  variant?: 'primary' | 'secondary' | 'outline';
  size?: 'sm' | 'md' | 'lg';
  class?: string;
}

const { variant = 'primary', size = 'md', class: className } = Astro.props as Props;

const baseStyles =
  'inline-flex items-center justify-center font-medium transition-colors focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-offset-background';

const variants = {
  primary: 'bg-accent text-background hover:opacity-90 focus:ring-accent',
  secondary: 'bg-elevated text-text-default hover:bg-content focus:ring-border',
  outline: 'border-2 border-accent text-accent hover:bg-content focus:ring-accent',
};

const sizes = {
  sm: 'px-3 py-1.5 text-sm rounded-sm',
  md: 'px-4 py-2 text-base rounded-radius',
  lg: 'px-6 py-3 text-lg rounded-lg',
};

const classes = `${baseStyles} ${variants[variant]} ${sizes[size]} ${className || ''}`;
---

<button class={classes} {...Astro.props}>
  <slot />
</button>
